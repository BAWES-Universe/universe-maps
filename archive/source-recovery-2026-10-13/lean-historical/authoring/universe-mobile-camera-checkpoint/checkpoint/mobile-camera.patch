+ function up(e){const p=pointers.get(e.pointerId);if(!p)return;const wasCamera=consumed.has(e.pointerId)||!!cameraGesture;pointers.delete(e.pointerId);consumed.delete(e.pointerId);try{canvas.releasePointerCapture(e.pointerId);}catch{}if(wasCamera){/* Finger removal changes the pinch pair and its center; rebase before the next move. */touchMetric=metrics();if(pointers.size===0){cameraGesture=null;touchMetric=null;consumed.clear();canvas.classList.remove('camera-dragging');onCameraChange(null);}return;}if(blocked()||e.button!==0)return;const hit=getRenderer().pick(e.clientX,e.clientY);if(getContext().building){getEditor()?.pointerUp(hit,e);return;}if(Math.hypot(e.clientX-p.startX,e.clientY-p.startY)>7)return;if(hit.id&&onInteract(hit))return;if(hit.point)onWalkTo(hit.point);}
  function cancelWorld(){for(const id of pointers.keys())try{canvas.releasePointerCapture(id);}catch{}pointers.clear();consumed.clear();cameraGesture=null;touchMetric=null;getEditor()?.cancelGesture();canvas.classList.remove('camera-dragging');onCameraChange(null);}
  function cancel(){cancelWorld();if(stickId!==null)try{joystickRoot.releasePointerCapture(stickId);}catch{}stickId=null;onJoystick({x:0,z:0});joystickThumb.style.transform='';}
  // Escape consumes the entire held pointer gesture. Its later move/up cannot
